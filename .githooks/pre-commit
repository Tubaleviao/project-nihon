#!/usr/bin/env bash
# Pre-commit checks that are cheap and deterministic, so a mistake fails here instead of a CI run later.
# Enable once per clone: git config core.hooksPath .githooks   (tools/install_hooks.sh does it)
# Skip in an emergency with `git commit --no-verify`; CI runs the same checks.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"

# Phase 254: every .gd / .gdshader in the index needs its .uid sidecar in the index too. It checks the whole
# index, not only this commit's files; CI keeps main clean, so a failure is almost always the new file. The most frequent CI failure in Nov 2026 was this one.
if ! "$root/tools/check_uids.sh" >/dev/null; then
  echo >&2
  echo "pre-commit: a script or shader has no tracked .uid (or a .uid lost its script)." >&2
  echo "  Generate the sidecars:  godot --headless --path . --import   (or open the project in the editor)" >&2
  echo "  then stage them:        git add '*.uid'" >&2
  exit 1
fi
