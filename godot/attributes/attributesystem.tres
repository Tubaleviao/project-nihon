ttribute":"intelligence","kind":"chance","base":0,"perPoint":0.01,"perPointBelow":0,"min":0,"max":0.22},"magicXpFactor":{"attribute":"intelligence","kind":"factor","base":1,"perPoint":0.02,"perPointBelow":0.02,"min":0.85,"max":1.45},"gatherYieldFactor":{"attribute":"perception","kind":"factor","base":1,"perPoint":0.015,"perPointBelow":0.015,"min":0.9,"max":1.35},"harvestQualityBonus":{"attribute":"perception","kind":"bonus","base":0,"perPoint":0.1,"perPointBelow":0.1,"min":-0.6,"max":2.2},"detectionRadiusMetres":{"attribute":"perception","kind":"amount","base":32,"perPoint":1.6,"perPointBelow":1.6,"min":24,"max":68,"unit":"m"}}
growth = {"xpPerPoint":600,"costStep":0.25,"totalPointsCap":40,"categories":{"combat":{"strength":0.5,"agility":0.5},"crafting":{"strength":0.5,"intelligence":0.5},"exploration":{"perception":0.5,"agility":0.5},"survival":{"vitality":0.5,"perception":0.5},"magic":{"intelligence":0.5,"resistance":0.5},"social":{"perception":1}}}
description = "The six character attributes (Strength, Vitality, Resistance, Agility, Intelligence, Perception), what each one feeds, and how skill use grows them. No classes and no levels: a character starts from creation and grows slowly from use. At base 10 in every attribute each derived stat equals the number the game used before attributes existed."
tags = ["attribute"]
