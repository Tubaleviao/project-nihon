[ext_resource type="Script" path="res://godot/loots/loottable.gd" id="1"]

[resource]
script = ExtResource("1")
id = ""
state = 0
creatureId = ""
despawnSeconds = 120
state_machine_field = "state"
initial_state = "sealed"
description = "Defines the rules that govern what items drop when a creature dies. Each creature's harvest table (its `drops` field, Phase 160) lists entries of item, quantity range, chance, the tool category that works the entry (knife, bonetool, none) and the scaling skill (Skinning); quantity and chance rise with Skinning level (see Skinning and HarvestRules). The LootTable is shared across all instances of a creature species; individual rolls are performed per kill by the loot system."
tags = ["loot"]
