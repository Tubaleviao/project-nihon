[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://godot/world_systems/settlementraids.gd" id="1"]

[resource]
script = ExtResource("1")
id = ""
rules = {"minAgeMinutes":30,"minTier":"growing","minStockpileStacks":10,"cooldownHours":6,"warningSeconds":120,"durationSeconds":600,"offlineProtection":true,"defenceCap":0.75,"stakes":{"stockpileShareMax":0.2,"projectDamageMax":0.25},"packs":{"TemperateForest":[{"creature":"GraywolfPack","min":3,"max":5},{"creature":"ForestBoar","min":1,"max":2}],"TemperateGrassland":[{"creature":"SteppeBison","min":2,"max":3},{"creature":"RidgeHawk","min":2,"max":4}],"VolcanicBadlands":[{"creature":"CinderGargoyle","min":2,"max":3},{"creature":"LavaSlug","min":2,"max":4}],"TwilightGrove":[{"creature":"VeilStalker","min":2,"max":3},{"creature":"GlimmerFox","min":2,"max":4}],"VoidRift":[{"creature":"VoidSerpent","min":2,"max":4}]}}
description = "Creature packs from the village's own biome attack a settlement that is worth raiding. Every raid is warned, never starts while no member is online inside the claim, and has a capped loss: a share of the stockpile and damage to unfinished projects, both reduced by raid-defence projects. Raids come from creatures only; settlement-against-settlement conflict is deferred."
tags = ["world-system"]
