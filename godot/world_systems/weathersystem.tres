[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://godot/world_systems/weathersystem.gd" id="1"]

[resource]
script = ExtResource("1")
id = ""
rules = {"cellSizeChunks":64,"hoursPerRoll":6,"overrideMaxHours":48,"states":{"clear":{"moveSpeedFactor":1,"visibilityFactor":1,"minTemperature":-100,"maxTemperature":100,"minRainfall":0,"weight":6,"biomes":[],"exceptBiomes":[]},"rain":{"moveSpeedFactor":0.95,"visibilityFactor":0.8,"minTemperature":0,"maxTemperature":100,"minRainfall":200,"weight":3,"biomes":[],"exceptBiomes":["VoidRift"]},"storm":{"moveSpeedFactor":0.7,"visibilityFactor":0.6,"minTemperature":5,"maxTemperature":100,"minRainfall":400,"weight":1,"biomes":[],"exceptBiomes":["VoidRift"]},"blizzard":{"moveSpeedFactor":0.6,"visibilityFactor":0.4,"minTemperature":-100,"maxTemperature":0,"minRainfall":100,"weight":2,"biomes":[],"exceptBiomes":["VoidRift"]},"fog":{"moveSpeedFactor":1,"visibilityFactor":0.5,"minTemperature":-10,"maxTemperature":25,"minRainfall":300,"weight":1.5,"biomes":[],"exceptBiomes":["VoidRift"]},"ash_fall":{"moveSpeedFactor":0.9,"visibilityFactor":0.5,"minTemperature":-100,"maxTemperature":100,"minRainfall":0,"weight":3,"biomes":["VolcanicBadlands"],"exceptBiomes":[]},"electrical_storm":{"moveSpeedFactor":0.8,"visibilityFactor":0.7,"minTemperature":-100,"maxTemperature":100,"minRainfall":0,"weight":3,"biomes":["TwilightGrove"],"exceptBiomes":[]},"void_storm":{"moveSpeedFactor":0.9,"visibilityFactor":0.6,"minTemperature":-100,"maxTemperature":100,"minRainfall":0,"weight":4,"biomes":["VoidRift"],"exceptBiomes":[]}},"climate":{"TemperateForest":{"temperature":10,"rainfall":900},"TemperateGrassland":{"temperature":12,"rainfall":600},"TwilightGrove":{"temperature":10,"rainfall":700},"VolcanicBadlands":{"temperature":30,"rainfall":100},"VoidRift":{"temperature":10,"rainfall":0}}}
description = "Simulates weather across biomes as an emergent world system. Weather is not authored — it emerges from biome parameters, seasonal cycles, and player-built infrastructure (logging, irrigation, chimneys). Effects are gameplay-significant: rain douses fires, storms disable airships, blizzards slow movement and starve uninsulated settlements."
tags = ["world-system"]
