rules = {"hearthStation":"hearth","hearthItem":"Hearth","guildMaxSettlements":1,"tiers":{"founded":{"minMembers":1,"minDays":0},"growing":{"minMembers":3,"minDays":3,"minProjects":2},"town":{"minMembers":8,"minDays":14}},"roles":{"founder":{"build":true,"take":true,"invite":true,"withdrawLimit":0},"elder":{"build":true,"take":true,"invite":true,"withdrawLimit":200},"member":{"build":true,"take":true,"invite":false,"withdrawLimit":50},"guest":{"build":false,"take":false,"invite":false,"withdrawLimit":0}},"stockpile":{"founded":{"capacityStacks":20},"growing":{"capacityStacks":60},"town":{"capacityStacks":160}},"abandonAfterDays":30}
