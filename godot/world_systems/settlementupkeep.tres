rules = {"periodHours":24,"shrinksClaim":false,"costs":{"founded":[{"item":"ThornwoodPlank","quantity":2}],"growing":[{"item":"ThornwoodPlank","quantity":6},{"item":"FerriteIngot","quantity":1}],"town":[{"item":"ThornwoodPlank","quantity":12},{"item":"FerriteIngot","quantity":3},{"item":"AshiteBlock","quantity":4}]}}
description = "What a village pays to keep going: a cost per tier taken from the stockpile every period. Unpaid upkeep suspends project effects until it is paid; it never shrinks the claim, which still follows only the activity-based abandonment rule. Upkeep never falls as the tier rises."
