rules = {"ownership":{"owners":["private","clan"],"defaultOwner":"private","edit":{"private":"owner","clan":"member"},"memberPrivateInTerritory":{"enter":true,"dismantle":true,"edit":false},"outsiders":"damage","touching":"eachKeepsOwn","buffer":1,"abandonedClan":"anyone"},"circle":{"minRadius":8,"maxRadius":128,"footprintFactor":1,"heightFactor":0.25},"floorHeight":3,"maxFloors":163,"classes":{"earth":{"maxFloors":1},"wood":{"maxFloors":2},"stone":{"maxFloors":5},"concrete":{"maxFloors":10},"steel":{"maxFloors":40},"composite":{"maxFloors":163}},"shapes":{"overhangReach":[{"above":8,"minClass":"wood"},{"above":16,"minClass":"stone"},{"above":48,"minClass":"steel"},{"above":128,"minClass":"composite"}],"unsupportedSpan":[{"above":16,"minClass":"wood"},{"above":32,"minClass":"stone"},{"above":96,"minClass":"steel"},{"above":256,"minClass":"composite"}],"heightToFootprint":[{"above":3,"minClass":"stone"},{"above":6,"minClass":"concrete"},{"above":12,"minClass":"steel"},{"above":24,"minClass":"composite"}]},"existingBuilds":"kept"}
description = "A connected set of placed blocks and the stations on them, owned by its builder or the builder's clan. Only its owner edits it, wherever it stands; anyone else may only damage it. Around it a circle, larger for a larger structure, where no creature spawns and, for a clan structure, where only that clan's members may build. Its floors are limited by the weakest material it carries (wood 2, stone 5, concrete 10, up to 163), and an unusual shape needs a stronger class. There is no claim area."
tags = ["world-system"]
