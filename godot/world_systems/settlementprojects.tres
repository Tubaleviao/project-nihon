script = ExtResource("1")
id = ""
rules = {"projects":{"palisade":{"minTier":"founded","materials":[{"item":"ThornwoodPlank","quantity":40},{"item":"FerriteIngot","quantity":4}],"places":{"block":"ThornwoodPlank","blocks":48,"layout":"ring","stations":[]}},"storehouse":{"minTier":"founded","materials":[{"item":"ThornwoodPlank","quantity":30},{"item":"AshiteBlock","quantity":12}],"places":{"block":"AshiteBlock","blocks":24,"layout":"shed","stations":[]}},"workshop":{"minTier":"founded","materials":[{"item":"ThornwoodPlank","quantity":20},{"item":"FerriteIngot","quantity":10},{"item":"AshiteBlock","quantity":10}],"places":{"block":"AshiteBlock","blocks":32,"layout":"hall","stations":["carpentry bench","forge"]}},"watchtower":{"minTier":"growing","materials":[{"item":"ThornwoodPlank","quantity":24},{"item":"AshiteBlock","quantity":16},{"item":"FerriteIngot","quantity":6}],"places":{"block":"AshiteBlock","blocks":40,"layout":"tower","stations":[]}}}}
description = "Structures a village builds together: a palisade, a storehouse, a workshop, a watchtower. Each needs materials, which members bring; it is complete once its materials are in, with no labour stage (Phase 203). A finished project is placed as blocks and stations, and changes nothing else: it counts toward no tier (Phase 207)."
tags = ["world-system"]
