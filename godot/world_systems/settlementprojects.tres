[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://godot/world_systems/settlementprojects.gd" id="1"]

[resource]
script = ExtResource("1")
id = ""
rules = {"workSecondsPerUnit":2,"projects":{"palisade":{"minTier":"founded","materials":[{"item":"ThornwoodPlank","quantity":40},{"item":"FerriteIngot","quantity":4}],"labour":[{"step":"posts","specialty":"woodworker","work":60},{"step":"raise","specialty":"builder","work":90}],"effects":[{"kind":"raidDefence","value":0.3}],"places":{"block":"ThornwoodPlank","blocks":48,"layout":"ring","stations":[]}},"storehouse":{"minTier":"founded","materials":[{"item":"ThornwoodPlank","quantity":30},{"item":"AshiteBlock","quantity":12}],"labour":[{"step":"foundation","specialty":"builder","work":60},{"step":"shelving","specialty":"woodworker","work":60},{"step":"provisions","specialty":"forager","work":30}],"effects":[{"kind":"stockpileCapacity","value":20},{"kind":"upkeepRelief","value":0.25}],"places":{"block":"AshiteBlock","blocks":24,"layout":"shed","stations":[]}},"workshop":{"minTier":"founded","materials":[{"item":"ThornwoodPlank","quantity":20},{"item":"FerriteIngot","quantity":10},{"item":"AshiteBlock","quantity":10}],"labour":[{"step":"walls","specialty":"builder","work":60},{"step":"benches","specialty":"woodworker","work":45},{"step":"anvil","specialty":"smith","work":45}],"effects":[{"kind":"craftSpeed","value":0.2}],"places":{"block":"AshiteBlock","blocks":32,"layout":"hall","stations":["carpentry bench","forge"]}},"watchtower":{"minTier":"growing","materials":[{"item":"ThornwoodPlank","quantity":24},{"item":"AshiteBlock","quantity":16},{"item":"FerriteIngot","quantity":6}],"labour":[{"step":"base","specialty":"builder","work":90},{"step":"lookout","specialty":"woodworker","work":60},{"step":"signal","specialty":"hunter","work":30}],"effects":[{"kind":"raidDefence","value":0.2}],"places":{"block":"AshiteBlock","blocks":40,"layout":"tower","stations":[]}}}}
description = "Structures a village builds together inside its claim: a palisade, a storehouse, a workshop, a watchtower. Each needs materials and labour in ordered steps; members contribute both, and a member whose specialty matches a step works faster on it. A finished project is placed as blocks and stations in the claim, and its effects (stockpile capacity, raid defence, crafting speed inside the claim, upkeep relief) hold while upkeep is paid. Completed projects also grow a village: the growing tier is reached by minMembers and minProjects as well as by days."
tags = ["world-system"]
