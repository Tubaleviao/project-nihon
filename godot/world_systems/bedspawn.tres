script = ExtResource("1")
id = ""
rules = {"stationType":"bed","placementItem":"Bed","perPlayer":1,"notices":{"placed":"bed.placed","lost":"bed.lost"},"shelter":{"roofWithinMetres":3,"sideReachMetres":2,"minClosedSides":3,"wallCheckMetres":1}}
