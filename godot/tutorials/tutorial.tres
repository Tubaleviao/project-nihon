script = ExtResource("1")
id = ""
chapters = ["moving","gathering","first_stations","first_tools","shelter","first_hunt","staying_alive","finding_way","growing","other_people"]
steps = [{"id":"move","chapter":"moving","inputs":["move"],"requires":[],"trigger":{"kind":"moved_metres","metres":10}},{"id":"jump","chapter":"moving","inputs":["jump"],"requires":["move"],"trigger":{"kind":"jumped"}},{"id":"look","chapter":"moving","inputs":["look","zoom"],"requires":["move"],"trigger":{"kind":"camera_turned"}},{"id":"controls","chapter":"moving","inputs":["controls"],"requires":["look"],"trigger":{"kind":"window_opened","window":"controls"}},{"id":"mine","chapter":"gathering","inputs":["mine"],"requires":["move"],"trigger":{"kind":"item_gathered","tag":"material","count":1}},{"id":"chop","chapter":"gathering","inputs":["attack"],"requires":["mine"],"trigger":{"kind":"item_gathered","item":"Thornwood","count":4}},{"id":"inventory","chapter":"gathering","inputs":[],"requires":["mine"],"trigger":{"kind":"window_opened","window":"inventory"}},{"id":"hotbar","chapter":"gathering","inputs":["drag","hotbar_expand","hotbar_use"],"requires":["inventory"],"trigger":{"kind":"hotbar_bound"}},{"id":"technology","chapter":"first_stations","inputs":[],"requires":["chop"],"trigger":{"kind":"window_opened","window":"technology"}},{"id":"research_carpentry","chapter":"first_stations","inputs":[],"requires":["technology"],"trigger":{"kind":"technology_researched","technology":"TechBasicCarpentry"}},{"id":"place_bench","chapter":"first_stations","inputs":["station"],"requires":["chop"],"trigger":{"kind":"station_placed","type":"carpentry bench"}},{"id":"crafting","chapter":"first_stations","inputs":[],"requires":["chop"],"trigger":{"kind":"window_opened","window":"crafting"}},{"id":"craft_planks","chapter":"first_stations","inputs":[],"requires":["place_bench","research_carpentry","crafting"],"trigger":{"kind":"item_crafted","item":"ThornwoodPlank"}},{"id":"place_forge","chapter":"first_tools","inputs":["station"],"requires":["craft_planks"],"trigger":{"kind":"station_placed","type":"forge"}},{"id":"research_smithing","chapter":"first_tools","inputs":[],"requires":["place_forge"],"trigger":{"kind":"technology_researched","technology":"TechBasicSmithing"}},{"id":"craft_tool","chapter":"first_tools","inputs":[],"requires":["research_smithing"],"trigger":{"kind":"item_crafted","tag":"pick"}},{"id":"use_tool","chapter":"first_tools","inputs":["mine"],"requires":["craft_tool"],"trigger":{"kind":"item_gathered","tag":"material","count":5}},{"id":"craft_bed","chapter":"shelter","inputs":[],"requires":["craft_planks"],"trigger":{"kind":"item_crafted","item":"Bed"}},{"id":"place_bed","chapter":"shelter","inputs":["station"],"requires":["craft_bed"],"trigger":{"kind":"bed_placed"}},{"id":"build_shelter","chapter":"shelter","inputs":["next_block","place"],"requires":["place_bed"],"trigger":{"kind":"shelter_complete"}},{"id":"equip_weapon","chapter":"first_hunt","inputs":["equipment"],"requires":["research_smithing"],"trigger":{"kind":"item_equipped","slot":"MainHand"}},{"id":"kill","chapter":"first_hunt","inputs":["attack"],"requires":["equip_weapon"],"trigger":{"kind":"creature_killed","tag":"creature"}},{"id":"harvest","chapter":"first_hunt","inputs":[],"requires":["kill"],"trigger":{"kind":"carcass_harvested"}},{"id":"respawn","chapter":"staying_alive","inputs":[],"requires":["place_bed"],"trigger":{"kind":"respawned"}},{"id":"map","chapter":"finding_way","inputs":[],"requires":["move"],"trigger":{"kind":"window_opened","window":"map"}},{"id":"waystone","chapter":"finding_way","inputs":[],"requires":["map"],"trigger":{"kind":"waystone_discovered"}},{"id":"skills","chapter":"growing","inputs":[],"requires":["chop"],"trigger":{"kind":"window_opened","window":"skills"}},{"id":"tier_up","chapter":"growing","inputs":[],"requires":["skills"],"trigger":{"kind":"skill_tier_up"}},{"id":"character","chapter":"growing","inputs":[],"requires":["skills"],"trigger":{"kind":"window_opened","window":"character"}},{"id":"chat","chapter":"other_people","inputs":["chat"],"requires":["controls"],"trigger":{"kind":"chat_sent"}},{"id":"trade","chapter":"other_people","inputs":[],"requires":["chat"],"trigger":{"kind":"window_opened","window":"trade"}},{"id":"settlement","chapter":"other_people","inputs":[],"requires":["build_shelter"],"trigger":{"kind":"window_opened","window":"settlement"}}]
triggerKinds = {"moved_metres":{"required":["metres"]},"camera_turned":{},"jumped":{},"item_gathered":{"required":["count"],"oneOf":["item","tag"]},"item_crafted":{"oneOf":["item","tag"]},"station_placed":{"required":["type"]},"window_opened":{"required":["window"]},"hotbar_bound":{},"item_equipped":{"required":["slot"]},"creature_killed":{"oneOf":["creature","tag"]},"carcass_harvested":{},"bed_placed":{},"shelter_complete":{},"respawned":{},"waystone_discovered":{},"skill_tier_up":{},"technology_researched":{"required":["technology"]},"chat_sent":{}}
inputActions = ["move","jump","look","zoom","hotbar_use","hotbar_expand","drag","attack","mine","place","next_block","station","tame","equipment","windows","controls","chat","close"]
windows = ["inventory","technology","crafting","trade","market","proposals","controls","character","skills","map","settlement","gestures"]
description = "The first-steps tutorial: an ordered list of small steps that teach a new player to move, gather, build the first stations and tools, make a shelter with a bed, hunt, stay alive, find their way, grow and meet other people. Each step names the keys it teaches and the event that completes it."
tags = ["tutorial"]
