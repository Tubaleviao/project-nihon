triggerKinds = {"moved_metres":{"required":["metres"]},"camera_turned":{},"jumped":{},"item_gathered":{"required":["count"],"oneOf":["item","tag"]},"item_crafted":{"oneOf":["item","tag"]},"station_placed":{"required":["type"]},"window_opened":{"required":["window"]},"hotbar_bound":{},"item_equipped":{"required":["slot"]},"creature_killed":{"oneOf":["creature","tag"]},"carcass_harvested":{},"bed_placed":{},"shelter_complete":{},"respawned":{},"waystone_discovered":{},"skill_tier_up":{},"technology_researched":{"required":["technology"]},"chat_sent":{},"project_started":{},"project_contributed":{}}
inputActions = ["move","jump","look","zoom","hotbar_use","hotbar_expand","drag","attack","mine","place","next_block","station","tame","mount","pick_up","equipment","chest","windows","controls","chat","close"]
windows = ["inventory","technology","crafting","trade","market","proposals","controls","attributes","equipment","skills","map","settlement","gestures"]
description = "The first-steps tutorial: an ordered list of small steps that teach a new player, who starts with nothing, to move, pick up branches and stones, make stone tools, build the first stations, make a shelter with a bed, hunt, stay alive, find their way, grow and meet other people. Each step names the keys it teaches and the event that completes it."
tags = ["tutorial"]
