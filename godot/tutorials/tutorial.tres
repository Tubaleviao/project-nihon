steps = [{"id":"move","chapter":"moving","inputs":["move"],"requires":[],"trigger":{"kind":"moved_metres","metres":10}},{"id":"jump","chapter":"moving","inputs":["jump"],"requires":["move"],"trigger":{"kind":"jumped"}},{"id":"look","chapter":"moving","inputs":["look","zoom"],"requires":["move"],"trigger":{"kind":"camera_turned"}},{"id":"controls","chapter":"moving","inputs":["controls"],"requires":["look"],"trigger":{"kind":"window_opened","window":"controls"}},{"id":"pick_branch","chapter":"gathering","inputs":["pick_up"],"requires":["move"],"trigger":{"kind":"item_gathered","item":"Branch","count":1}},{"id":"pick_stone","chapter":"gathering","inputs":["pick_up"],"requires":["move"],"trigger":{"kind":"item_gathered","item":"LooseStone","count":1}},{"id":"inventory","chapter":"gathering","inputs":[],"requires":["pick_branch"],"trigger":{"kind":"window_opened","window":"inventory"}},{"id":"hotbar","chapter":"gathering","inputs":["drag","hotbar_expand","hotbar_use"],"requires":["inventory"],"trigger":{"kind":"hotbar_bound"}},{"id":"crafting","chapter":"first_tools","inputs":[],"requires":["pick_branch","pick_stone"],"trigger":{"kind":"window_opened","window":"crafting"}},{"id":"craft_axe","chapter":"first_tools","inputs":[],"requires":["crafting"],"trigger":{"kind":"item_crafted","item":"StoneAxe"}},{"id":"chop","chapter":"first_tools","inputs":["attack"],"requires":["craft_axe"],"trigger":{"kind":"item_gathered","item":"Thornwood","count":4}},{"id":"craft_pick","chapter":"first_tools","inputs":[],"requires":["craft_axe"],"trigger":{"kind":"item_crafted","item":"StonePick"}},{"id":"craft_shovel","chapter":"first_tools","inputs":[],"requires":["craft_axe"],"trigger":{"kind":"item_crafted","item":"StoneShovel"}},{"id":"dig","chapter":"first_tools","inputs":["mine"],"requires":["craft_shovel"],"trigger":{"kind":"item_gathered","item":"Soil","count":1}},{"id":"mine_stone","chapter":"first_tools","inputs":["mine"],"requires":["craft_pick"],"trigger":{"kind":"item_gathered","item":"Ferrite","count":1}},{"id":"technology","chapter":"first_stations","inputs":[],"requires":["chop"],"trigger":{"kind":"window_opened","window":"technology"}},{"id":"research_carpentry","chapter":"first_stations","inputs":[],"requires":["technology"],"trigger":{"kind":"technology_researched","technology":"TechBasicCarpentry"}},{"id":"craft_bench","chapter":"first_stations","inputs":[],"requires":["pick_branch","pick_stone"],"trigger":{"kind":"item_crafted","item":"CarpentryBench"}},{"id":"place_bench","chapter":"first_stations","inputs":["station"],"requires":["craft_bench"],"trigger":{"kind":"station_placed","type":"carpentry bench"}},{"id":"craft_planks","chapter":"first_stations","inputs":[],"requires":["place_bench","research_carpentry"],"trigger":{"kind":"item_crafted","item":"ThornwoodPlank"}},{"id":"research_smithing","chapter":"first_stations","inputs":[],"requires":["craft_planks"],"trigger":{"kind":"technology_researched","technology":"TechBasicSmithing"}},{"id":"craft_forge","chapter":"first_stations","inputs":[],"requires":["research_smithing","place_bench"],"trigger":{"kind":"item_crafted","item":"Forge"}},{"id":"place_forge","chapter":"first_stations","inputs":["station"],"requires":["craft_forge"],"trigger":{"kind":"station_placed","type":"forge"}},{"id":"craft_tool","chapter":"first_stations","inputs":[],"requires":["place_forge","mine_stone"],"trigger":{"kind":"item_crafted","item":"FerritePick"}},{"id":"use_tool","chapter":"first_stations","inputs":["mine"],"requires":["craft_tool"],"trigger":{"kind":"item_gathered","tag":"material","count":5}},{"id":"craft_bed","chapter":"shelter","inputs":[],"requires":["craft_planks"],"trigger":{"kind":"item_crafted","item":"Bed"}},{"id":"place_bed","chapter":"shelter","inputs":["station"],"requires":["craft_bed"],"trigger":{"kind":"bed_placed"}},{"id":"craft_hammer","chapter":"shelter","inputs":[],"requires":["craft_axe"],"trigger":{"kind":"item_crafted","item":"StoneHammer"}},{"id":"build_shelter","chapter":"shelter","inputs":["next_block","place"],"requires":["place_bed","craft_hammer"],"trigger":{"kind":"shelter_complete"}},{"id":"equip_weapon","chapter":"first_hunt","inputs":["equipment"],"requires":["research_smithing"],"trigger":{"kind":"item_equipped","slot":"MainHand"}},{"id":"kill","chapter":"first_hunt","inputs":["attack"],"requires":["equip_weapon"],"trigger":{"kind":"creature_killed","tag":"creature"}},{"id":"craft_knife","chapter":"first_hunt","inputs":[],"requires":["craft_axe"],"trigger":{"kind":"item_crafted","item":"StoneKnife"}},{"id":"harvest","chapter":"first_hunt","inputs":[],"requires":["kill","craft_knife"],"trigger":{"kind":"carcass_harvested"}},{"id":"respawn","chapter":"staying_alive","inputs":[],"requires":["place_bed"],"trigger":{"kind":"respawned"}},{"id":"map","chapter":"finding_way","inputs":[],"requires":["move"],"trigger":{"kind":"window_opened","window":"map"}},{"id":"waystone","chapter":"finding_way","inputs":[],"requires":["map"],"trigger":{"kind":"waystone_discovered"}},{"id":"skills","chapter":"growing","inputs":[],"requires":["chop"],"trigger":{"kind":"window_opened","window":"skills"}},{"id":"tier_up","chapter":"growing","inputs":[],"requires":["skills"],"trigger":{"kind":"skill_tier_up"}},{"id":"character","chapter":"growing","inputs":[],"requires":["skills"],"trigger":{"kind":"window_opened","window":"attributes"}},{"id":"chat","chapter":"other_people","inputs":["chat"],"requires":["controls"],"trigger":{"kind":"chat_sent"}},{"id":"trade","chapter":"other_people","inputs":[],"requires":["chat"],"trigger":{"kind":"window_opened","window":"trade"}},{"id":"settlement","chapter":"other_people","inputs":[],"requires":["build_shelter"],"trigger":{"kind":"window_opened","window":"settlement"}},{"id":"found_village","chapter":"first_village","inputs":["station"],"requires":["settlement"],"trigger":{"kind":"station_placed","type":"hearth"}},{"id":"start_project","chapter":"first_village","inputs":[],"requires":["found_village"],"tri