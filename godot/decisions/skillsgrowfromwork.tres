[ext_resource type="Script" path="res://godot/decisions/skillsgrowfromwork.gd" id="1"]

[resource]
script = ExtResource("1")
id = ""
status = 1
decided = "2026-10-31"
state_machine_field = "status"
initial_state = "accepted"
description = "Crafting, gathering, building, dismantling and repairing grow the worker's own skill for that kind of work (sewing makes you a better sewer). Nothing a member does is progress for a clan: clan projects have no labour and are complete once their materials are in. Clan tiers come from the buildings a clan owns and their material rarity, and give nothing yet. Raids are not wanted now (deferred) and upkeep is removed. Clan skills for top contributors and elder-only buildings come later."
tags = ["decision"]
