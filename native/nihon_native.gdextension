[configuration]

entry_symbol = "nihon_native_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://native/bin/libnihon_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/bin/libnihon_native.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://native/bin/libnihon_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/libnihon_native.windows.template_release.x86_64.dll"
macos.debug = "res://native/bin/libnihon_native.macos.template_debug.dylib"
macos.release = "res://native/bin/libnihon_native.macos.template_release.dylib"
